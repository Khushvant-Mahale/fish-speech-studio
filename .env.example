# =====================================================================
# Kashva Voice — Environment Configuration Template
# Copy this file to .env and configure your production values.
# =====================================================================

# Server & Network Configuration
HOST=0.0.0.0
PORT=7865

# Tier & Production Mode (free | pro)
STUDIO_TIER=free

# Optional: Cloud Engine API Keys (for BYOK or Cloud Tier)
# If left empty, free local engines (Fish Speech Free, Kokoro 82M, Microsoft Edge TTS) work out of the box.
ELEVENLABS_API_KEY=
OPENAI_API_KEY=
CARTESIA_API_KEY=
FISH_API_KEY=

# Optional: Remote Cloud GPU Accelerators (Google Colab / Kaggle T4 / RunPod / Modal)
FISH_WORKER_URL=
KOKORO_WORKER_URL=

# Kaggle Cloud GPU Worker (Optional)
KAGGLE_USERNAME=
KAGGLE_KEY=
